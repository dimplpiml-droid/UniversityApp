<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniversityApp.App"
             xmlns:local="using:UniversityApp"
             xmlns:viewModels="clr-namespace:UniversityApp.ViewModels"
             xmlns:views="clr-namespace:UniversityApp.Views"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

             <Application.DataTemplates>
                 <DataTemplate DataType="viewModels:LoginViewModel"><views:LoginView /></DataTemplate>
                 <DataTemplate DataType="viewModels:ShellViewModel"><views:ShellView /></DataTemplate>
                 <DataTemplate DataType="viewModels:TablePageViewModel"><views:TablePageView /></DataTemplate>
             </Application.DataTemplates>

             <Application.Styles>
                 <FluentTheme />
                 <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
             </Application.Styles>
</Application>