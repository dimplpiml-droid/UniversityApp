<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniversityApp.ViewModels"
             xmlns:views="using:UniversityApp.Views"
             x:Class="UniversityApp.App"
             RequestedThemeVariant="Light">

    <!-- Какой ViewModel каким View рисуется -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
        <DataTemplate DataType="vm:ShellViewModel"><views:ShellView /></DataTemplate>

        <DataTemplate DataType="vm:ExamsPageViewModel"><views:ExamsView /></DataTemplate>
        <DataTemplate DataType="vm:DepartmentsPageViewModel"><views:DepartmentsView /></DataTemplate>
        <DataTemplate DataType="vm:DisciplinesPageViewModel"><views:DisciplinesView /></DataTemplate>
        <DataTemplate DataType="vm:EmployeesPageViewModel"><views:EmployeesView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>

</Application>