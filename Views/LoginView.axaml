<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniversityApp.Views.LoginView">
  
  <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
    <TextBlock Text="Вход в систему" FontSize="22" HorizontalAlignment="Center" />
    <TextBox Text="{Binding LoginText}" Watermark="Логин" />
    <TextBox Text="{Binding Password}" PasswordChar="*" Watermark="Пароль">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}" />
      </TextBox.KeyBindings>
    </TextBox>
    <Button Content="Войти" Command="{Binding SignInCommand}"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
