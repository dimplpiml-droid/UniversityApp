<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniversityApp.Views.TablePageView">
  <DockPanel Margin="10">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBox Width="220" Watermark="Поиск..." Text="{Binding SearchText}" />
      <TextBlock Text="Сортировка:" VerticalAlignment="Center" />
      <ComboBox Width="170" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
      <CheckBox Content="По убыванию" IsChecked="{Binding Descending}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Добавить" Command="{Binding AddCommand}" IsVisible="{Binding CanAdd}" />
      <Button Content="Изменить" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" />
      <Button Content="Удалить" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
      <Button Content="Обновить" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>

    <DataGrid x:Name="MainGrid"
              ItemsSource="{Binding Items}"
              SelectedItem="{Binding SelectedItem}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="All"
              BorderThickness="1" BorderBrush="Gray" />
  </DockPanel>
</UserControl>
