<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:UniversityApp.Models"
        x:Class="UniversityApp.Views.EditDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="8">

    <ItemsControl x:Name="FieldsList">
      <ItemsControl.DataTemplates>
        <DataTemplate DataType="m:TextField">
          <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding Label}" />
            <TextBox Text="{Binding Value}" IsReadOnly="{Binding ReadOnly}" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="m:ChoiceField">
          <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding Label}" />
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"
                      IsEnabled="{Binding IsEditable}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.DataTemplates>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="OK" Width="90" HorizontalContentAlignment="Center" Click="Ok_Click" />
      <Button Content="Отмена" Width="90" HorizontalContentAlignment="Center" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
