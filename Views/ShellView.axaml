<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniversityApp.Views.ShellView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#EEEEEE" Padding="10,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Выйти" Command="{Binding LogoutCommand}" />
        <TextBlock Text="{Binding UserInfo}" VerticalAlignment="Center" Foreground="Black" />
      </DockPanel>
    </Border>

    <ListBox DockPanel.Dock="Left" Width="180"
             ItemsSource="{Binding Pages}"
             SelectedItem="{Binding SelectedPage}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>


    <DockPanel Margin="10">

      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding SelectedPage.Title}" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
          <TextBox Width="220" Watermark="Поиск..." Text="{Binding SelectedPage.SearchText}" />
          <TextBlock Text="Сортировка:" VerticalAlignment="Center" />
          <ComboBox Width="150"
                    ItemsSource="{Binding SelectedPage.SortOptions}"
                    SelectedItem="{Binding SelectedPage.SelectedSort}" />
          <CheckBox Content="По убыванию" IsChecked="{Binding SelectedPage.Descending}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="Фильтры:" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding SelectedPage.Filters}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <ComboBox Width="150" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Сбросить" Command="{Binding SelectedPage.ClearFiltersCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="{Binding SelectedPage.AddText}" Command="{Binding SelectedPage.AddCommand}" IsVisible="{Binding SelectedPage.CanAdd}" />
        <Button Content="{Binding SelectedPage.EditText}" Command="{Binding SelectedPage.EditCommand}" IsVisible="{Binding SelectedPage.CanEdit}" />
        <Button Content="Удалить" Command="{Binding SelectedPage.DeleteCommand}" IsVisible="{Binding SelectedPage.CanDelete}" />
        <Button Content="Обновить" Command="{Binding SelectedPage.RefreshCommand}" />
        <TextBlock Text="{Binding SelectedPage.Status}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>

      <ContentControl Content="{Binding SelectedPage}" DoubleTapped="Grid_DoubleTapped" />
    </DockPanel>
  </DockPanel>
</UserControl>
